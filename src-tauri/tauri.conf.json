{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "企与星河",
  "version": "0.1.0",
  "identifier": "com.framework.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:6130"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon-32.ico",
      "icons/icon-64.ico"
    ],
    "resources": [
      "../plugins",
      "../plugins-data",
      "../db"
    ],
    "targets": "nsis",
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "languages": [
          "SimpChinese"
        ]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "企与星河",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src * asset: data: blob: 'unsafe-inline' 'unsafe-eval'; script-src * asset: 'unsafe-inline' 'unsafe-eval'; style-src * asset: 'unsafe-inline'; img-src * asset: data: blob:; connect-src * asset:; font-src * data:; media-src *; frame-src *; worker-src *",
      "capabilities": [
        "default-capability",
        "settings-capability",
        "plugins-capability"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**/*"
        ]
      }
    }
  }
}
