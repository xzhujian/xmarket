{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framework App",
  "version": "0.1.0",
  "identifier": "com.framework.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:6130"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["../plugins", "../plugins-data"],
    "targets": "nsis",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Framework App",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src * asset: data: blob: 'unsafe-inline' 'unsafe-eval'; script-src * asset: 'unsafe-inline' 'unsafe-eval'; style-src * asset: 'unsafe-inline'; img-src * asset: data: blob:; connect-src * asset:; font-src * data:; media-src *; frame-src *; worker-src *",
      "capabilities": ["default-capability"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**/*"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:framework.db"
      ]
    }
  }
}
